# Copy to .env and set values for your AWS account.
# DOMAIN_NAME is added to the API's allowed CORS origins and attached to CloudFront.
# Set HOSTED_ZONE_ID to let CDK manage the ACM certificate and Route 53 alias records.
# HOSTED_ZONE_NAME is optional and defaults to the parent domain of DOMAIN_NAME.
ENVIRONMENT=prod
DOMAIN_NAME=callbreak.kharelutsab.com
HOSTED_ZONE_ID=Z01809651YQNR8FJNNIW
HOSTED_ZONE_NAME=kharelutsab.com
